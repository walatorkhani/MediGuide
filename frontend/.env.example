# URL de base de l'API backend, avec le préfixe /api.
# En développement : le backend local sur le port 5000.
# En production (Vercel) : l'URL Railway du backend déployé, à définir dans
# Vercel > Project Settings > Environment Variables (PAS dans ce fichier,
# qui n'est là qu'à titre d'exemple et n'est jamais lu en production).
VITE_API_URL=http://localhost:5000/api
